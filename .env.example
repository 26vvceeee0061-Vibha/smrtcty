# Server -----------------------------------------------------------------------
PORT=4173
HOST=127.0.0.1

# PostgreSQL -------------------------------------------------------------------
# Set DATABASE_URL to use a real PostgreSQL server. When it is omitted, the
# server uses embedded PGlite and stores data under PGLITE_DATA_DIR.
# DATABASE_URL=postgres://quantum:quantum@127.0.0.1:5432/quantum_flux
PGLITE_DATA_DIR=.data/pglite

# LangChain --------------------------------------------------------------------
# Without OPENAI_API_KEY (or with ADVISORY_PROVIDER=local) the server uses the
# deterministic local LangChain chain instead of calling OpenAI.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000
ADVISORY_PROVIDER=auto
